# Copy to .env (in this folder) and fill in your keys. Never commit .env.
OPENAI_API_KEY=
MODEL=openai:gpt-6-luna
TAVILY_API_KEY=
# Langfuse Cloud (free Hobby plan, one project per student). Keys must come from the same region as the base URL.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Model that grades briefs (LLM-as-a-judge). Empty = same as MODEL; a different model avoids self-preference.
JUDGE_MODEL=
