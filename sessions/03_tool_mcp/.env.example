# Copy to .env (in this folder) and fill in your keys. Never commit .env.
OPENAI_API_KEY=
MODEL=openai:gpt-6-luna
TAVILY_API_KEY=

# MCP server without authentication (uv run app/shop_server.py --http, notebook 02)
SHOP_PORT=8000
# SHOP_MCP_URL=https://<name>.ngrok-free.dev/mcp   # optional: the URL logged by --public (default http://localhost:$SHOP_PORT/mcp)
# MCP server with API keys (uv run app/shop_server_auth.py, notebook 03)
SHOP_AUTH_PORT=8001
# SHOP_AUTH_MCP_URL=https://<name>.ngrok-free.dev/mcp   # optional, as above (default http://localhost:$SHOP_AUTH_PORT/mcp)
# The two API keys of that server. Make each one with: uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
SHOP_READ_KEY=
SHOP_WRITE_KEY=

# Optional: public URL with ngrok (--public). Authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Encryption key of the OAuth token store (Notion sign-in, notebook 03). Make it with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_STORAGE_ENCRYPTION_KEY=
# Extension only (docs/03_auth.md): an OAuth client you registered at Google, for the Google Drive MCP server
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
