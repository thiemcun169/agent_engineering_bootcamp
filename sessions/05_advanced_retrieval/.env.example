# Copy to .env (in this folder) and fill in your keys. Never commit .env.
OPENAI_API_KEY=
MODEL=openai:gpt-6-luna

# Optional MCP server with a public URL (uv run app/kb_mcp_server.py --http --public, docs/02_mcp_server.md)
# Authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# API key every client of the public server sends. Make it with: uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
KB_READ_KEY=
