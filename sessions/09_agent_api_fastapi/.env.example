# Copy to .env (in this folder) and fill in your keys. Never commit .env.
OPENAI_API_KEY=
MODEL=openai:gpt-6-luna
TAVILY_API_KEY=
# Optional: where the notebooks find the service (default http://127.0.0.1:8000)
# API_URL=http://127.0.0.1:8000
# Secret that signs the access tokens (JWT). Generate one: openssl rand -hex 32
# (or: uv run python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=
