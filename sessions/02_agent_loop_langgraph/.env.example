# Copy to .env (in this folder) and fill in your keys. Never commit .env.
# LLM: any "provider:model" string accepted by LangChain init_chat_model. Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
MODEL=openai:gpt-6-luna
# Web search and page extraction: https://app.tavily.com/ (the free tier is enough)
TAVILY_API_KEY=
